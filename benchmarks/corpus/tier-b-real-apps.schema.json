{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protoloom.dev/schema/tier-b-real-apps.schema.json",
  "title": "PROTOLOOM real-app corpus",
  "type": "object",
  "required": ["version", "apps"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "license", "source_commit", "schema_tree_url", "schema_paths", "artifact"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "license": {"type": "string", "minLength": 1},
          "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "schema_tree_url": {"type": "string", "pattern": "^https://"},
          "schema_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "\\.proto$"}},
          "artifact": {
            "type": "object",
            "required": ["url", "sha256", "size"],
            "additionalProperties": false,
            "properties": {
              "url": {"type": "string", "pattern": "^https://"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size": {"type": "integer", "minimum": 1, "maximum": 536870912}
            }
          }
        }
      }
    }
  }
}
